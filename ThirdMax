class Solution
{
    public int thirdMax(int[] nums)
    {
      int temp=0;
      for(int i=0;i<nums.length-1;i++)
      {
        for(int j=0;j<nums.length-1-i;j++) 
        {
            if(nums[j]>nums[j+1])
            {
                temp=nums[j];
                nums[j]=nums[j+1];
                nums[j+1]=temp;
            }
        }
      } 
      int count=1;
      for(int k=nums.length-2;k>=0;k--)
      {
        if(nums[k]!=nums[k+1])
        count++;
        if(count==3)
        return nums[k];
         
      }
      return nums[nums.length-1];
    }

}
