    {
        String revstr="";
        String rev="";
        s=s.toUpperCase();
        for(int i=0;i<s.length();i++)
        {
            char ch=s.charAt(i);
            if(Character.isLetterOrDigit(ch))
            {
             revstr=ch+revstr;
             rev=rev+ch;
            }
            else if(ch==32)
            {
            }
        }
      if(revstr.equals(rev))
        return true;
      else
       return false;
    }
}
